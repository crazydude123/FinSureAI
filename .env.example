# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Supabase Storage Bucket Name (optional, defaults to 'datasets')
SUPABASE_BUCKET=datasets

# Modal Configuration (for GPU training and inference)
MODAL_API_TOKEN=your_modal_api_token
MODAL_API_SECRET=your_modal_api_secret

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
