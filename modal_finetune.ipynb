   "source": [
    "# Modal Finetuning Notebook (SFT + GRPO/ART)\\n\\n",
    "This notebook defines a Modal app for finetuning Qwen on financial QA dataset.\\n\\n",
    "**To run:**\\n",
    "`modal run modal_finetune.ipynb::finetune_model`\\n\\n",
    "**Requirements:**\\n",
    "- `reward.py` and `requirements.txt` in the same directory (use the modal_finetune.zip provided)\\n",
    "- Modal account setup (`modal token new`)\\n\\n",
    "Models will be saved to persistent Modal Volume `finsure-models`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import modal\\n",
    "from modal import Image, App, gpu\\n\\n",
    "app = App(\\\"finsure-modal-notebook\\\")\\n\\n",
    "image = (\\n",
    "    Image.debian_slim()\\n",
    "    .pip_install_from_requirements(\\\"requirements.txt\\\")\\n",
    "    .run_commands(\\n",
    "        \\\"apt-get update && apt-get install -y git\\\",\\n",
    "        \\\"pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121\\\",\\n",
    "        \\\"pip install bitsandbytes\\\",  # Install bitsandbytes for CUDA on Modal\\n",
    "        \\\"pip install git+https://github.com/openpipe/art.git\\\"  # Install ART from GitHub\\n",
    "    )\\n",
    "    .copy_local_file(\\\"reward.py\\\", \\\"/reward.py\\\")  # Copy reward.py into the image\\n",
    ")\\n\\n",
    "volume = modal.Volume.from_name(\\\"finsure-models\\\", create_if_missing=True)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
